NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://agora.studio.example

DATABASE_URL=mysql://agora_app:CHANGE_ME@agora-db:3306/agora_db
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
AGORA_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY

OIDC_ISSUER_URL=https://auth.studio.example/application/o/agora/
OIDC_CLIENT_ID=agora-web
OIDC_CLIENT_SECRET=SET_ON_SERVER_ONLY
OIDC_REDIRECT_URI=https://agora.studio.example/api/oauth/callback
OIDC_ALLOWED_SUBJECTS=OWNER_SUBJECT_OPTIONAL_COLLEAGUE_SUBJECTS
OWNER_OIDC_SUBJECT=OWNER_SUBJECT

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=agora-private
S3_ACCESS_KEY=agora_minio
S3_SECRET_KEY=CHANGE_ME
# Lasciare vuoto con MinIO privo di KMS/KES. Valori supportati: AES256, aws:kms.
S3_SERVER_SIDE_ENCRYPTION=
# Obbligatorio solo quando S3_SERVER_SIDE_ENCRYPTION=aws:kms.
S3_KMS_KEY_ID=
MINIO_ROOT_USER=agora_minio
MINIO_ROOT_PASSWORD=CHANGE_ME

LOG_LEVEL=info
