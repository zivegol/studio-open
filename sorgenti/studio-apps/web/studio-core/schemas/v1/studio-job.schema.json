{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-example:studio-core:schema:v1:studio-job",
  "title": "StudioJob v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "correlationId", "dossierId", "appId", "jobType", "state", "createdBy", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "jobId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": "string", "format": "uuid"},
    "dossierId": {"type": "string", "format": "uuid"},
    "appId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "jobType": {"type": "string", "minLength": 1},
    "state": {"enum": ["queued", "processing", "ready", "partial", "failed", "stale"]},
    "parameters": {"type": "object"},
    "metrics": {"type": "object"},
    "errorCode": {"type": ["string", "null"]},
    "createdBy": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
