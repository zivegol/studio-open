{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studio-example:studio-core:schema:v1:project-manifest",
  "title": "ProjectManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "projectId", "clientId", "dossierId", "appId", "createdAt", "updatedAt", "runs", "sources", "outputs", "approvals"],
  "properties": {
    "manifestVersion": {"const": "1.0.0"},
    "projectId": {"type": "string", "format": "uuid"},
    "clientId": {"type": "string", "format": "uuid"},
    "dossierId": {"type": "string", "format": "uuid"},
    "appId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "runs": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "sources": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "outputs": {"type": "array", "items": {"type": "object"}},
    "approvals": {"type": "array", "items": {"type": "object"}}
  }
}
